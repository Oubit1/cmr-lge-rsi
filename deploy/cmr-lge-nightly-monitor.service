[Unit]
Description=CMR+LGE overnight metrics recorder
After=cmr-lge-autopilot.service

[Service]
Type=simple
WorkingDirectory=/srv/rsi/project
ExecStart=/srv/rsi/project/.venv/bin/python -u scripts/nightly_monitor.py --hours 0 --interval 300
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
