{
  "version": "2026-10-21",
  "purpose": "Generic pattern catalogue; private case identities and replay examples are excluded.",
  "cases": [
    {
      "pattern": "tiny_far_unsupported_mi",
      "action": "remove",
      "evidence": [
        "very small component <=20px",
        "far from main MI",
        "no adjacent-layer support",
        "weak or absent high signal"
      ],
      "automatic": true
    },
    {
      "pattern": "small_unsupported_mi_extended",
      "action": "remove",
      "evidence": [
        "components=2",
        "small component area in (20, 40] px",
        "area ratio < 0.15",
        "no adjacent-layer MI within 15px"
      ],
      "automatic": true
    },
    {
      "pattern": "isolated_non_mi_myo_satellite",
      "action": "remove_non_mi_myo_satellite",
      "evidence": [
        "secondary Myo component contains 0 MI pixels",
        "area <= 100px or ratio < 0.12 of main LV ring",
        "isolated false-positive tissue (blood pool/chest wall)"
      ],
      "automatic": true
    },
    {
      "pattern": "nearby_same_territory_mi_threshold_gap",
      "action": "conservative_3x3_closing_in_myo",
      "evidence": [
        "components within 1-3 pixels of each other",
        "same myocardial segment",
        "added pixels <= 30",
        "strictly clipped to Myo"
      ],
      "automatic": true
    },
    {
      "pattern": "myo_internal_gap",
      "action": "fill_myo_review",
      "evidence": [
        "upper/lower Myo topology supports completion",
        "not a true apex/base boundary"
      ],
      "automatic": false
    },
    {
      "pattern": "high_fraction_but_smooth_transmural_mi",
      "action": "keep_without_change",
      "evidence": [
        "single connected MI",
        "adjacent ratios change smoothly",
        "original LGE supports high signal"
      ],
      "automatic": true
    },
    {
      "pattern": "high_fraction_outside_high_signal_boundary",
      "action": "mild_shrink_review",
      "evidence": [
        "mask extends beyond visible high-signal boundary",
        "shrink constrained to Myo"
      ],
      "automatic": false
    },
    {
      "pattern": "two_valid_separate_mi_regions",
      "action": "keep_separate",
      "evidence": [
        "both regions have original high signal",
        "adjacent layers support both",
        "do not force connectivity"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_apex_base_largest_continuous_ring",
      "action": "keep_largest_with_adjacent_support",
      "evidence": [
        "apex/base partial ring is anatomically plausible",
        "adjacent z-slices or temporal frames support the retained region",
        "do not force a closed ring"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_anatomical_boundary_outside_trusted_sax_core",
      "action": "reclassify_check_pool_to_boundary_without_label_edit",
      "evidence": [
        "persistent multi-chamber/outflow-tract anatomy across cine frames",
        "volume lies in a contiguous spatial prefix/suffix outside the longest trusted SAX core",
        "trusted SAX core has >=3 volumes and >=60% physiological-ring frames per volume",
        "isolated internal failures remain in middle QC"
      ],
      "automatic": false,
      "status": "experimental_pending_fixed_validation"
    },
    {
      "pattern": "cmr_lge_reference_position",
      "action": "select_cmr_component_nearest_single_component_lge_myo",
      "evidence": [
        "LGE Myo is single-component",
        "normalized center agrees",
        "CMR components are otherwise ambiguous"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_temporal_position_and_small_internal_gap",
      "action": "copy_or_fill_only_with_neighbor_support",
      "evidence": [
        "previous/next temporal frames agree",
        "small internal gap is not the central blood pool",
        "result remains one anatomical ring"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_ring_gap_restricted_batch",
      "action": "small_5x5_closure",
      "evidence": [
        "candidate comes from current CMR issue manifest",
        "<=100 added pixels",
        ">=20% adjacent-frame support",
        "central hole preserved"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_temporal_missing_blood_pool_hole",
      "action": "carve_temporally_bracketed_hole",
      "evidence": [
        "solid cine frames (holes=0) bracketed by single-ring frames with matching blood-pool hole Dice >= 0.80",
        "carved proposal strictly enclosed in myocardium",
        "topology restores to components=1, holes=1"
      ],
      "automatic": true
    },
    {
      "pattern": "cmr_cyclic_cine_temporal_continuity",
      "action": "accept_with_cyclic_continuity",
      "evidence": [
        "CMR short-axis cine is a periodic heartbeat cycle",
        "boundary cine frame 1 and frame N are continuous in cyclic time",
        "smooth centroid drift <=8px and single-ring LGE support"
      ],
      "automatic": true
    },
    {
      "pattern": "lge_cross_slice_continuity_and_blood_pool_leak",
      "action": "refine_lge_cross_slice_continuity",
      "evidence": [
        "secondary MI component in remote sector lacks z-overlap with adjacent slices (overlap=0)",
        "endocardium leaks into hyperintense cavity blood pool (>500) causing false circumferential MI",
        "MI ratio jumps abnormally >0.60 into remote negative tissue",
        "prune unsupported islands, remove blood pool leak, and constrain to remote mean+3SD"
      ],
      "automatic": true
    }
  ]
}
